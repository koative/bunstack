{
	"name": "arcstack",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --filter '@apps/*' dev",
		"build": "bun run --filter '@apps/*' build",
		"start": "bun run --filter '@apps/*' start",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "bun run --filter './packages/*' test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/bun": "latest",
		"typescript": "^5.9.3"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"catalog": {
		"next": "^16.2.12",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/node": "^22",
		"tailwindcss": "^4",
		"@tailwindcss/postcss": "^4",
		"tw-animate-css": "^1",
		"shadcn": "^4.16.1",
		"lucide-react": "^1.28.0",
		"sonner": "^2.0.7",
		"hono": "^4"
	}
}
