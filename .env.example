# Environment
NODE_ENV=development

# Database
POSTGRES_DB=eros
POSTGRES_USER=eros
POSTGRES_PASSWORD=eros

# Crawler engine
CRAWLER_PORT=1337
LOG_LEVEL=info
WORKER_CONCURRENCY=4
BULLMQ_PREFIX=eros:crawl
RECRAWL_INTERVAL_MS=60000
ENGINE_API_KEY=

# Admin UI
ADMIN_PORT=1002
ADMIN_USER=admin
ADMIN_PASSWORD=

# Storage (s3 | local | memory)
STORAGE_DRIVER=s3
STORAGE_LOCAL_ROOT=./.data/blobs

# MinIO / S3
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=eros
S3_ACCESS_KEY_ID=erosadmin
S3_SECRET_ACCESS_KEY=erosadmin123
S3_VIRTUAL_HOSTED_STYLE=false
